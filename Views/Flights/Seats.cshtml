@model SeatMapViewModel

@{
    ViewData["Title"] = "Asientos";
    var airports = ViewBag.Airports as Dictionary<string, airport> ?? new Dictionary<string, airport>();
    airports.TryGetValue(Model.Route?.departure_airport ?? "", out var depAirport);
    airports.TryGetValue(Model.Route?.arrival_airport ?? "", out var arrAirport);
    var fareClasses = new[] { "Economy", "Comfort", "Business" };
    var classIcons = new Dictionary<string, string>
    {
        ["Economy"] = "fa-chair",
        ["Comfort"] = "fa-person-carry-box",
        ["Business"] = "fa-briefcase"
    };
}

<div class="d-flex align-items-center mb-3 section-title">
    <i class="fa-solid fa-chair me-2 fs-3"></i>
    <h2 class="mb-0">Selección de asiento</h2>
</div>

<div class="card app-card mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="airport-chip"><i class="fa-solid fa-plane"></i> @Model.Flight.route_no</span>
            <span class="airport-chip airport-chip-wrap" title="@(depAirport?.airport_name)">
                <i class="fa-solid fa-location-dot"></i> @(depAirport?.airport_name ?? Model.Route?.departure_airport)
            </span>
            <i class="fa-solid fa-arrow-right-long text-muted"></i>
            <span class="airport-chip airport-chip-wrap" title="@(arrAirport?.airport_name)">
                <i class="fa-solid fa-location-arrow"></i> @(arrAirport?.airport_name ?? Model.Route?.arrival_airport)
            </span>
            <span class="ms-auto text-muted">
                <i class="fa-solid fa-calendar-days me-1"></i>@Model.Flight.scheduled_departure.ToString("dd/MM/yyyy HH:mm")
            </span>
        </div>

        <form method="get" asp-action="Seats" class="row g-2 align-items-center">
            <input type="hidden" name="flightId" value="@Model.FlightId" />
            <div class="col-auto">
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-layer-group"></i></span>
                    <select name="fareClass" class="form-select" onchange="this.form.submit()">
                        @foreach (var fc in fareClasses)
                        {
                            <option value="@fc" selected="@(fc == Model.FareClass)">
                                @fc - $@PriceForClass(fc).ToString("0.00")
                            </option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-auto">
                <span class="badge text-bg-primary fs-6">
                    <i class="fa-solid fa-tag me-1"></i>$@Model.Price.ToString("0.00") USD
                </span>
            </div>
        </form>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
    </div>
}

<h5>
    <i class="@(classIcons.TryGetValue(Model.FareClass, out var ic) ? ic : "fa-chair") me-1"></i>
    Asientos @Model.FareClass
    <span class="text-muted fs-6">(@Model.AvailableSeats.Count disponibles de @Model.AllSeats.Count)</span>
</h5>

<div class="seat-legend mb-3">
    <span class="legend-item">
        <span class="legend-swatch border border-success" style="background:#dff3e4"></span>Disponible
    </span>
    <span class="legend-item">
        <span class="legend-swatch bg-secondary"></span>Ocupado
    </span>
</div>

@if (Model.AvailableSeats.Count == 0)
{
    <div class="alert alert-warning">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>No hay asientos disponibles en esta clase.
    </div>
}
else
{
    <form method="post" asp-action="Reserve">
        <input type="hidden" name="flightId" value="@Model.FlightId" />
        <input type="hidden" name="fareConditions" value="@Model.FareClass" />
        <input type="hidden" name="price" value="@Model.Price" />
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var seat in Model.AvailableSeats)
            {
                <button type="submit" name="seatNo" value="@seat" class="btn btn-outline-success seat-btn" title="Reservar asiento @seat">
                    <i class="fa-solid fa-chair me-1"></i>@seat
                </button>
            }
        </div>
    </form>
}

<h5 class="text-muted"><i class="fa-solid fa-lock me-1"></i>Ocupados</h5>
<div class="d-flex flex-wrap gap-2 mb-3">
    @foreach (var seat in Model.UnavailableSeats)
    {
        <span class="btn btn-secondary btn-sm seat-btn disabled">
            <i class="fa-solid fa-ban me-1"></i>@seat
        </span>
    }
    @if (Model.UnavailableSeats.Count == 0)
    {
        <span class="text-muted">No hay asientos ocupados en este vuelo.</span>
    }
</div>

<p class="mt-3">
    <a asp-action="Details" asp-route-id="@Model.FlightId" class="btn btn-sm btn-sky">
        <i class="fa-solid fa-circle-info me-1"></i>Detalles
    </a>
    <a asp-action="Index" class="btn btn-sm btn-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>Volver a vuelos
    </a>
</p>

@functions {
    private static decimal PriceForClass(string fareClass)
    {
        return fareClass.ToLower() switch
        {
            "business" => 300m,
            "comfort" => 200m,
            _ => 100m
        };
    }
}
