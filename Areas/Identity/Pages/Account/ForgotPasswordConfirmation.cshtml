@page
@{
    ViewData["Title"] = "Instrucciones enviadas";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card app-card auth-card">
            <div class="card-body text-center">
                <h2 class="mb-3">Revisa tu correo</h2>
                <p class="text-muted">Si existe una cuenta asociada, recibirás instrucciones para restablecer tu contraseña.</p>
                <a asp-page="/Index" class="btn btn-sky">Volver al inicio</a>
            </div>
        </div>
    </div>
</div>
