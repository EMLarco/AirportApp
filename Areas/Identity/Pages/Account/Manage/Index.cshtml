@page
@model AirportWebApp.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "Administrar cuenta";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card app-card">
            <div class="card-body">
                <h2>Administrar cuenta</h2>
                <p class="text-muted">Información de la cuenta y opciones.</p>

                <dl class="row">
                    <dt class="col-sm-4">Correo</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                </dl>

                <a asp-page="/Account/Manage/ChangePassword" class="btn btn-outline-primary">Cambiar contraseña</a>
            </div>
        </div>
    </div>
</div>
