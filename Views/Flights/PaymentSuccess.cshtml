@model SeatReservation

@{
    ViewData["Title"] = "Pago exitoso";
}

<div class="text-center mb-4">
    <i class="fa-solid fa-circle-check text-success result-icon"></i>
    <h2 class="mt-3">Pago completado</h2>
    <p class="lead text-muted">Tu reserva fue confirmada exitosamente.</p>
</div>

<div class="card app-card mb-4 mx-auto" style="max-width: 640px;">
    <div class="card-body p-4 confirm-box">
        <dl class="row mb-0">
            <dt class="col-sm-4"><i class="fa-solid fa-plane me-2"></i>Vuelo</dt>
            <dd class="col-sm-8 fw-semibold">@Model.Flight.route_no</dd>

            <dt class="col-sm-4"><i class="fa-solid fa-chair me-2"></i>Asiento</dt>
            <dd class="col-sm-8">@Model.SeatNo</dd>

            <dt class="col-sm-4"><i class="fa-solid fa-layer-group me-2"></i>Clase</dt>
            <dd class="col-sm-8">@Model.FareConditions</dd>

            <dt class="col-sm-4"><i class="fa-solid fa-calendar-days me-2"></i>Salida</dt>
            <dd class="col-sm-8">@Model.Flight.scheduled_departure.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-4"><i class="fa-solid fa-money-bill-wave me-2"></i>Monto pagado</dt>
            <dd class="col-sm-8 fw-bold text-success">$@Model.Price.ToString("0.00") USD</dd>
        </dl>
    </div>
</div>

<div class="text-center">
    <a asp-action="Index" class="btn btn-primary btn-lg">
        <i class="fa-solid fa-magnifying-glass me-2"></i>Buscar más vuelos
    </a>
</div>
