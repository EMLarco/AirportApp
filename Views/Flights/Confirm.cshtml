@{
    ViewData["Title"] = "Confirmar reserva";
    var reservation = ViewBag.Reservation as SeatReservation;
    var flightRoute = ViewBag.Route as route;
}

<div class="d-flex align-items-center mb-4 section-title">
    <i class="fa-solid fa-file-circle-check me-2 fs-3"></i>
    <h2 class="mb-0">Confirmar reserva</h2>
</div>

<div class="card app-card mb-4">
    <div class="card-body p-4">
        <dl class="row mb-0 confirm-box fs-5">
            <dt class="col-sm-4"><i class="fa-solid fa-plane me-2"></i>Vuelo</dt>
            <dd class="col-sm-8 fw-semibold">@reservation.Flight.route_no</dd>

            <dt class="col-sm-4"><i class="fa-solid fa-route me-2"></i>Ruta</dt>
            <dd class="col-sm-8">
                <span class="airport-chip"><i class="fa-solid fa-location-dot"></i>@flightRoute?.departure_airport</span>
                <i class="fa-solid fa-arrow-right-long mx-2 text-muted"></i>
                <span class="airport-chip"><i class="fa-solid fa-location-arrow"></i>@flightRoute?.arrival_airport</span>
            </dd>

            <dt class="col-sm-4"><i class="fa-solid fa-calendar-days me-2"></i>Salida</dt>
            <dd class="col-sm-8">@reservation.Flight.scheduled_departure.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-4"><i class="fa-solid fa-chair me-2"></i>Asiento</dt>
            <dd class="col-sm-8 fw-semibold">@reservation.SeatNo</dd>

            <dt class="col-sm-4"><i class="fa-solid fa-layer-group me-2"></i>Clase</dt>
            <dd class="col-sm-8">@reservation.FareConditions</dd>

            <dt class="col-sm-4"><i class="fa-solid fa-money-bill-wave me-2"></i>Total a pagar</dt>
            <dd class="col-sm-8 fs-4 fw-bold text-success">$@ViewBag.Total.ToString("0.00") USD</dd>
        </dl>
    </div>
</div>

<div class="alert alert-info d-flex align-items-center">
    <i class="fa-brands fa-paypal fa-2x paypal-icon me-3"></i>
    <div>
        <strong>Pago con PayPal (sandbox)</strong><br />
        Al continuar serás redirigido a PayPal para completar el pago de forma segura.
    </div>
</div>

<form method="post" asp-action="Pay">
    <input type="hidden" name="reservationId" value="@reservation.Id" />
    <button type="submit" class="btn btn-primary btn-lg">
        <i class="fa-brands fa-paypal me-2"></i>Pagar con PayPal
    </button>
    <a asp-action="Seats" asp-route-flightId="@reservation.FlightId" asp-route-fareClass="@reservation.FareConditions" class="btn btn-secondary btn-lg">
        <i class="fa-solid fa-chair me-1"></i>Cambiar asiento
    </a>
</form>
