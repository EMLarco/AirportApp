@model IEnumerable<AirportWebApp.Models.Booking.Payment>

@{
    ViewData["Title"] = "Pagos";
}

<h1>Pagos</h1>
<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Orden</th>
            <th>Usuario</th>
            <th>Gateway</th>
            <th>Monto</th>
            <th>Estado</th>
            <th>Fecha</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var payment in Model)
    {
        <tr>
            <td>@payment.Id</td>
            <td>@payment.OrderId</td>
            <td>@payment.UserId</td>
            <td>@payment.Gateway</td>
            <td>$@payment.Amount</td>
            <td>@payment.Status</td>
            <td>@payment.CreationDate.ToString("g")</td>
        </tr>
    }
    </tbody>
</table>
