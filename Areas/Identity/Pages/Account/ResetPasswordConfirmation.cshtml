@page
@{
    ViewData["Title"] = "Contraseña restablecida";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card app-card auth-card">
            <div class="card-body text-center">
                <h2 class="mb-3">Contraseña restablecida</h2>
                <p class="text-muted">Tu contraseña ha sido restablecida correctamente.</p>
                <a asp-page="/Account/Login" asp-area="Identity" class="btn btn-sky">Iniciar sesión</a>
            </div>
        </div>
    </div>
</div>
