@model AirportWebApp.Models.Admin.AdminDashboardViewModel

@{
    ViewData["Title"] = "Panel de Administrador";
}

<h1>Panel de Administrador</h1>
<div class="row">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Órdenes</h5>
                <p class="card-text display-6">@Model.TotalOrders</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Pagos</h5>
                <p class="card-text display-6">@Model.TotalPayments</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title">Transacciones</h5>
                <p class="card-text display-6">@Model.TotalTransactions</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title">Ingreso</h5>
                <p class="card-text display-6">$@Model.TotalRevenue</p>
            </div>
        </div>
    </div>
</div>

<div class="mb-3">
    <a class="btn btn-outline-primary me-2" asp-action="Orders">Ver órdenes</a>
    <a class="btn btn-outline-success me-2" asp-action="Payments">Ver pagos</a>
    <a class="btn btn-outline-warning" asp-action="Transactions">Ver transacciones</a>
</div>
